COMPOSE_PROJECT_NAME=frigodons
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml

DOMAIN_NAME=localhost

APP_SECRET=ThisTokenIsNotSecretAndShouldBeChangedAndItShouldBeAtLeast64CharLong
JWT_SECRET=ThisJwtSecretIsNotSecretAndShouldBeChangedAndItShouldBeAtLeast64CharLong
APP_URL=http://localhost:5173
ALTCHA_HMAC_KEY=ThisAltchaKeyIsNotSecretAndShouldBeChanged
# The IP addresses of the proxies allowed to forward the IP of visitors (eg. the Cloudflare ranges in production)
TRUSTED_PROXIES=

DATABASE_HOST=database
DATABASE_PORT=5432
DATABASE_NAME=frigodons
DATABASE_USERNAME=frigodons
DATABASE_PASSWORD=frigodons

MAILER_DSN=smtp://mailhog:1025
MAILER_FROM=nepasrepondre@frigodons.org
MAILER_FROM_NAME="La Cordée"
MAILER_REPLY_TO=lacordee44@protonmail.com
MAILER_REPLY_TO_NAME="La Cordée"
# Receives an email when a scheduled task fails (leave empty to disable)
ALERT_EMAIL=

# The following env vars are only needed for dev/test envirnoments
TEST_DATABASE_NAME=frigodons_test

# The following env vars are only needed for prod environments
BACKUP_S3_HOST=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
