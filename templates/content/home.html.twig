{% extends 'base.html.twig' %}
{% set containerDiv = false %}

{% block body %}
  <div class="grid lg:h-[calc(100vh-124px)] home pb-20 lg:pb-0">
    <div class="lg:flex flex-row lg:space-x-16">
      <div class="flex h-5/6 mt-20 lg:mt-0 lg:h-auto lg:basis-2/3 bg-no-repeat bg-contain bg-center"
           style="background-image: url('{{ asset('img/flyer-pique-nique.jpg') }}');">
      </div>
        <div class="flex text-center mt-8 lg:mt-0 lg:basis-1/3">
          <div class="m-auto">
            <p class="mt-8">L’équipe du Frig’o dons vous invite à un</p>
            <h2>Pique-Nique (et BBQ) partagé</h2>
            <p>Le samedi 14 juin à partir de 12h</p>
            <p>Aux Jardins Familiaux, rue de la Gaudinière à La Montagne, (face à la salle de sport Jules Ladoumègue)</p>
            <p class="underline"><a target="_blank" href="https://maps.app.goo.gl/kozjsxyWQU6kFA7E8">Voir sur une carte</a></p>
            <p class="mt-8">Chacun apporte un pique nique à partager et/ou des grillades pour le barbecue.<p>
            <p>L'équipe de La Cordée prévoit des bancs et tables, tout ce qu'il faut pour le barbecue et des jeux pour prolonger l’après-midi.</p>
            <p>Venez nombreux !</p>
          </div>
        </div>
    </div>
  </div>
{% endblock %}
